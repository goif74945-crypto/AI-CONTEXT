{
  "schema_version": "1.0.0",
  "stores": [
    {
      "store": "PostgreSQL CORE",
      "objects": [
        "PipelineRun",
        "DirectiveRecord",
        "legacy directive/dispatch"
      ],
      "authority": "CORE",
      "write_semantics": "transactional; per-run lifecycle separated from global FSM"
    },
    {
      "store": "PostgreSQL VAULT",
      "objects": [
        "Project",
        "Artifact",
        "Revision",
        "Commit",
        "FreezeIncident"
      ],
      "authority": "VAULT",
      "write_semantics": "versioned/OCC/idempotent; Revision/Commit immutable; Project/Artifact soft-delete"
    },
    {
      "store": "PostgreSQL OBS",
      "objects": [
        "EventLog",
        "AuditLog",
        "SecurityIncident"
      ],
      "authority": "OBS",
      "write_semantics": "Event/Audit append-only; sequence/hash-chain integrity"
    },
    {
      "store": "PostgreSQL AUTH",
      "objects": [
        "User",
        "Session",
        "OTAC pending/auth state"
      ],
      "authority": "AUTH",
      "write_semantics": "transactional auth lifecycle; session revocation/TTL"
    },
    {
      "store": "Object/Blob Storage",
      "objects": [
        "artifact content"
      ],
      "authority": "VAULT",
      "write_semantics": "content hash + blobRef linked from immutable Commit"
    },
    {
      "store": "Future WAL/Snapshot",
      "objects": [
        "canonical sovereign state"
      ],
      "authority": "SOVEREIGN CORE",
      "write_semantics": "WAL-first fsync and two-phase snapshot under future constitutional law"
    }
  ],
  "forbidden_patterns": [
    "JUDGE → CORE foreign-key authority",
    "JUDGE → VAULT direct dependency",
    "OBS → CORE/VAULT foreign-key authority",
    "UI → LAW/VAULT direct authority",
    "SWARM → VAULT direct write",
    "Revision/Commit overwrite",
    "EventLog/AuditLog update/delete"
  ]
}
