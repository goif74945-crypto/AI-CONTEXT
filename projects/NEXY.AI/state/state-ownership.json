{
  "schema_version": "1.0.0",
  "implementation_head": "9c9befd9fe255b0f9271e6e2b8c4bb2443a08089",
  "states": [
    {
      "state": "PipelineRun",
      "authoritative_owner": "CORE",
      "writers": [
        "packages/queue/run-state.ts",
        "pipeline/orchestration paths"
      ],
      "readers": [
        "CORE",
        "API",
        "OBS by correlation"
      ],
      "store": "PostgreSQL:pipeline_runs",
      "lifetime": "per execution run",
      "version": "schema-bound",
      "recovery": "freeze incident/replay path as applicable",
      "audit": "requestId/traceId + EventLog/AuditLog correlation",
      "mutability": "mutable lifecycle fields under controlled transactions"
    },
    {
      "state": "DirectiveRecord",
      "authoritative_owner": "CORE",
      "writers": [
        "directive API/ingestion"
      ],
      "readers": [
        "CORE",
        "API"
      ],
      "store": "PostgreSQL:directive_records_v2",
      "lifetime": "persistent",
      "version": "schemaVersion + createdTick",
      "recovery": "idempotency/linked PipelineRun",
      "audit": "requestId/traceId via run/events",
      "mutability": "created record; idempotency key unique"
    },
    {
      "state": "FreezeIncident",
      "authoritative_owner": "VAULT/INCIDENT",
      "writers": [
        "packages/queue/run-state.ts",
        "packages/obs/incidents.ts",
        "daemon/freeze path"
      ],
      "readers": [
        "API/OBS/OWNER"
      ],
      "store": "PostgreSQL:freeze_incidents",
      "lifetime": "retention policy",
      "version": "createdTick",
      "recovery": "recover only if recoverable + authorized actor",
      "audit": "requestId/traceId/primary error/blocking layer",
      "mutability": "incident evidence; source design treats as persistent evidence"
    },
    {
      "state": "SecurityIncident",
      "authoritative_owner": "OBS/SECURITY",
      "writers": [
        "packages/obs/incidents.ts",
        "AUTH/security paths"
      ],
      "readers": [
        "OBS/AUDIT/OWNER"
      ],
      "store": "PostgreSQL:security_incidents",
      "lifetime": "365 days current default",
      "version": "createdTick",
      "recovery": "primary/secondary incident linkage",
      "audit": "self-referential primaryIncidentId",
      "mutability": "persistent incident record"
    },
    {
      "state": "EventLog",
      "authoritative_owner": "OBS",
      "writers": [
        "authorized subsystem emitters via insert"
      ],
      "readers": [
        "OBS/AUDIT/JUDGE by allowed evidence path"
      ],
      "store": "PostgreSQL:event_log",
      "lifetime": "90 days current default",
      "version": "monotonic sequenceNum",
      "recovery": "sequence gap is alert/data-loss signal",
      "audit": "requestId/traceId",
      "mutability": "APPEND_ONLY; no update/delete"
    },
    {
      "state": "AuditLog",
      "authoritative_owner": "OBS",
      "writers": [
        "authorized security/accountability paths via insert"
      ],
      "readers": [
        "AUDITOR/OWNER/SYSTEM/JUDGE via OBS"
      ],
      "store": "PostgreSQL:audit_log",
      "lifetime": "365 days current default",
      "version": "chainHash + previousEntryId",
      "recovery": "tamper requires incident; history not rewritten",
      "audit": "itself is tamper-evident audit chain",
      "mutability": "APPEND_ONLY; no update/delete"
    },
    {
      "state": "Project",
      "authoritative_owner": "VAULT",
      "writers": [
        "Vault commit/project service"
      ],
      "readers": [
        "authorized Vault/API"
      ],
      "store": "PostgreSQL:projects",
      "lifetime": "persistent/soft-delete",
      "version": "createdTick/deletedTick",
      "recovery": "restore if lineage valid",
      "audit": "Vault audit path",
      "mutability": "soft-delete allowed"
    },
    {
      "state": "Artifact",
      "authoritative_owner": "VAULT",
      "writers": [
        "Vault"
      ],
      "readers": [
        "authorized Vault/API"
      ],
      "store": "PostgreSQL:artifacts",
      "lifetime": "persistent/soft-delete",
      "version": "createdTick/deletedTick",
      "recovery": "restore if project/lineage/blob valid",
      "audit": "Vault audit path",
      "mutability": "soft-delete allowed"
    },
    {
      "state": "Revision",
      "authoritative_owner": "VAULT",
      "writers": [
        "Vault commit path"
      ],
      "readers": [
        "authorized Vault/API"
      ],
      "store": "PostgreSQL:revisions",
      "lifetime": "persistent",
      "version": "revisionNo + canonVersion",
      "recovery": "append new revision, never overwrite",
      "audit": "commit lineage",
      "mutability": "IMMUTABLE once created"
    },
    {
      "state": "Commit",
      "authoritative_owner": "VAULT",
      "writers": [
        "Vault commit path"
      ],
      "readers": [
        "authorized Vault/API"
      ],
      "store": "PostgreSQL:commits + blobRef object storage",
      "lifetime": "persistent",
      "version": "canonVersion + previousVersion",
      "recovery": "OCC/idempotency prevents duplicate/stale overwrite",
      "audit": "authorId/message/contentHash",
      "mutability": "IMMUTABLE once created"
    },
    {
      "state": "User",
      "authoritative_owner": "AUTH",
      "writers": [
        "AUTH/account authority"
      ],
      "readers": [
        "AUTH/RBAC"
      ],
      "store": "PostgreSQL:users",
      "lifetime": "persistent/deactivation",
      "version": "createdTick/deactivatedTick",
      "recovery": "governed account/role path",
      "audit": "auth events/audit",
      "mutability": "role/deactivation governed"
    },
    {
      "state": "Session",
      "authoritative_owner": "AUTH",
      "writers": [
        "packages/auth/session.ts",
        "packages/api/auth.ts"
      ],
      "readers": [
        "AUTH/API"
      ],
      "store": "PostgreSQL:sessions",
      "lifetime": "6h current default unless revoked",
      "version": "createdTick/lastSeenTick",
      "recovery": "new authenticated session; revoked session never reactivates",
      "audit": "requestId/traceId + auth events",
      "mutability": "revocation/lastSeen updates allowed"
    },
    {
      "state": "JudgmentRecord",
      "authoritative_owner": "JUDGE",
      "writers": [
        "JUDGE"
      ],
      "readers": [
        "JUDGE/AUDIT"
      ],
      "store": "PostgreSQL:judgment_records",
      "lifetime": "persistent",
      "version": "createdTick",
      "recovery": "derive from OBS audit evidence; no CORE/VAULT direct dependency",
      "audit": "references AuditLog",
      "mutability": "record-oriented"
    },
    {
      "state": "OrchestrationEnvelope",
      "authoritative_owner": "ORCH",
      "writers": [
        "orchestration/API boundary"
      ],
      "readers": [
        "operators/OBS"
      ],
      "store": "PostgreSQL:orchestration_envelopes",
      "lifetime": "persistent evidence/history",
      "version": "version + createdTick",
      "recovery": "reconstruct via requestId/traceId/run links",
      "audit": "requestId/traceId",
      "mutability": "APPEND_ONLY per schema commentary"
    }
  ]
}
