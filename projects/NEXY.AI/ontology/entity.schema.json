{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/projects/NEXY.AI/ontology/entity.schema.json",
  "title": "NEXY Atomic Ontology Entity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "aliases",
    "entity_type",
    "parent_id",
    "authority",
    "scope",
    "status",
    "source_range",
    "description",
    "responsibilities",
    "inputs",
    "outputs",
    "dependencies",
    "dependents",
    "contracts",
    "invariants",
    "states",
    "failure_behavior",
    "recovery",
    "security_boundary",
    "persistence",
    "determinism",
    "implementation_refs",
    "test_refs",
    "evidence_refs",
    "supersedes",
    "superseded_by",
    "conflicts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entity_type": {
      "enum": [
        "SYSTEM",
        "SUBSYSTEM",
        "MODULE",
        "ENGINE",
        "LAYER",
        "SERVICE",
        "RUNTIME",
        "KERNEL",
        "FABRIC",
        "PLANE",
        "ZONE",
        "LAW",
        "INVARIANT",
        "PROTOCOL",
        "FSM",
        "STATE",
        "EVENT",
        "CONTRACT",
        "SCHEMA",
        "DATA_MODEL",
        "MEMORY",
        "STORAGE",
        "LEDGER",
        "REGISTRY",
        "QUEUE",
        "ADAPTER",
        "GATEWAY",
        "CONTROLLER",
        "MONITOR",
        "DETECTOR",
        "FILTER",
        "RESOLVER",
        "ORCHESTRATOR",
        "AUDITOR",
        "SYNTHESIZER",
        "EXTRACTOR",
        "UI_SURFACE",
        "ROLE",
        "SECURITY_BOUNDARY",
        "HARDWARE_PATH",
        "TOOLCHAIN",
        "EVIDENCE_CLASS",
        "CONFIG",
        "ERROR",
        "WORKFLOW",
        "CONCEPT"
      ]
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "CONFLICT",
        "CURRENT_BUILD",
        "CURRENT_CANON",
        "HISTORICAL",
        "SOURCE_DESIGN"
      ]
    },
    "source_range": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document",
          "sha256",
          "start_paragraph",
          "end_paragraph"
        ],
        "properties": {
          "document": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "start_paragraph": {
            "type": "integer",
            "minimum": 1
          },
          "end_paragraph": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_behavior": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recovery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security_boundary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "persistence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "determinism": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
