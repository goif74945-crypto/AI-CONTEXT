{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/nexy/control-plane/heartbeat/heartbeat.schema.json",
  "title": "NEXY Worker Claim Heartbeat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "heartbeat_id",
    "worker_id",
    "claim_id",
    "command_id",
    "lease_epoch",
    "heartbeat_sequence",
    "observed_at",
    "worker_status",
    "evidence_refs"
  ],
  "properties": {
    "heartbeat_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "heartbeat_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "worker_status": {
      "enum": [
        "AVAILABLE",
        "BUSY",
        "DRAINING"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
