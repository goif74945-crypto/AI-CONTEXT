{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/nexy/control-plane/command/command.schema.json",
  "title": "NEXY Control Plane Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "command_type",
    "version",
    "audit_run_id",
    "created_from_head",
    "target_repo",
    "target_branch",
    "expected_head",
    "finding_ids",
    "root_cause_ids",
    "affected_systems",
    "affected_requirements",
    "affected_invariants",
    "priority",
    "severity",
    "dependencies",
    "allowed_change_surface",
    "forbidden_change_surface",
    "objective",
    "exact_required_changes",
    "non_goals",
    "acceptance_criteria",
    "required_tests",
    "negative_tests",
    "regression_tests",
    "security_tests",
    "expected_evidence",
    "rollback",
    "stale_head_policy",
    "human_gate",
    "supersedes",
    "status",
    "task_id",
    "target_scope",
    "retry_policy"
  ],
  "properties": {
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "created_from_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "expected_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "audit_run_id": {
      "type": "string",
      "minLength": 1
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "target_repo": {
      "type": "string",
      "minLength": 1
    },
    "target_branch": {
      "type": "string",
      "minLength": 1
    },
    "target_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_change_surface": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbidden_change_surface": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "negative_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "regression_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rollback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expected_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "backoff_policy",
        "retryable_states"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "backoff_policy": {
          "type": "string",
          "minLength": 1
        },
        "retryable_states": {
          "type": "array",
          "items": {
            "enum": [
              "FAILED",
              "BLOCKED"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "READY",
        "CLAIMED",
        "EXECUTING",
        "VERIFYING",
        "COMPLETED",
        "FAILED",
        "BLOCKED",
        "STALE",
        "CANCELLED",
        "QUARANTINED"
      ]
    },
    "command_type": {
      "enum": [
        "BUILD",
        "REPAIR",
        "MODIFY",
        "DELETE",
        "MIGRATE",
        "TEST",
        "EVIDENCE_REFRESH",
        "SECURITY_FIX",
        "RECOVERY_FIX",
        "CONTRACT_FIX",
        "FSM_FIX",
        "STATE_FIX",
        "INTEGRATION_FIX",
        "RELEASE_FIX",
        "HUMAN_DECISION"
      ]
    },
    "root_cause_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "affected_systems": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "affected_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "affected_invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "priority": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "NORMAL",
        "LOW"
      ]
    },
    "severity": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "exact_required_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "security_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "stale_head_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_head_mismatch",
        "revalidate_with"
      ],
      "properties": {
        "on_head_mismatch": {
          "const": "MARK_STALE_AND_DO_NOT_EXECUTE"
        },
        "revalidate_with": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "reason"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$comment": "Contract revision 1.1.0: represents every field mandated by SYSTEM:NEXY::FULL-PROJECT-SPEC-AUDITOR-AND-COMMAND-GENERATOR-V1 while retaining exact-head closed-loop controls."
}
