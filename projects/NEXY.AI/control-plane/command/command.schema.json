{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/nexy/control-plane/command/command.schema.json",
  "title": "NEXY Control Plane Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "version",
    "created_from_head",
    "expected_head",
    "audit_run_id",
    "finding_ids",
    "task_id",
    "target_repo",
    "target_branch",
    "target_scope",
    "allowed_change_surface",
    "forbidden_change_surface",
    "dependencies",
    "objectives",
    "acceptance",
    "required_tests",
    "negative_tests",
    "regression_tests",
    "security_checks",
    "rollback",
    "expected_evidence",
    "stale_policy",
    "retry_policy",
    "supersedes",
    "status"
  ],
  "properties": {
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "created_from_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "expected_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "audit_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "target_repo": {
      "type": "string",
      "minLength": 1
    },
    "target_branch": {
      "type": "string",
      "minLength": 1
    },
    "target_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_change_surface": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbidden_change_surface": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "negative_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "regression_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "security_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rollback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expected_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "stale_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_head_mismatch",
        "revalidate_with"
      ],
      "properties": {
        "on_head_mismatch": {
          "const": "MARK_STALE_AND_DO_NOT_EXECUTE"
        },
        "revalidate_with": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "backoff_policy",
        "retryable_states"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "backoff_policy": {
          "type": "string",
          "minLength": 1
        },
        "retryable_states": {
          "type": "array",
          "items": {
            "enum": [
              "FAILED",
              "BLOCKED"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "READY",
        "CLAIMED",
        "EXECUTING",
        "VERIFYING",
        "COMPLETED",
        "FAILED",
        "BLOCKED",
        "STALE",
        "CANCELLED",
        "QUARANTINED"
      ]
    }
  }
}
