{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/nexy/control-plane/runtime/runtime-envelope.schema.json",
  "title": "NEXY Closed-Loop Runtime Command Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["command", "runtime"],
  "properties": {
    "command": {
      "type": "object",
      "required": [
        "command_id", "expected_head", "target_repo", "target_branch", "target_scope",
        "allowed_change_surface", "forbidden_change_surface", "dependencies", "status"
      ],
      "properties": {
        "command_id": {"type": "string", "minLength": 1},
        "expected_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "target_repo": {"type": "string", "minLength": 1},
        "target_branch": {"type": "string", "minLength": 1},
        "target_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "allowed_change_surface": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "forbidden_change_surface": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "status": {"const": "READY"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "enqueue_sequence", "target_role", "required_capabilities", "requires_human_gate"],
      "properties": {
        "priority": {"enum": ["CRITICAL", "HIGH", "NORMAL", "LOW"]},
        "enqueue_sequence": {"type": "integer", "minimum": 0},
        "target_role": {"enum": ["BUILDER", "AUDITOR"]},
        "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "requires_human_gate": {"type": "boolean"},
        "resource_claims": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "dependency_claims": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
