{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/nexy/control-plane/supersession/supersession.schema.json",
  "title": "NEXY Command Supersession Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_id",
    "version",
    "edges"
  ],
  "properties": {
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_command_id",
        "new_command_id",
        "reason",
        "evidence_refs",
        "old_status",
        "new_expected_head"
      ],
      "properties": {
        "old_command_id": {
          "type": "string",
          "minLength": 1
        },
        "new_command_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "enum": [
            "HEAD_STALE",
            "SCOPE_REVALIDATED",
            "AUTHORITY_CHANGED",
            "DEPENDENCY_CHANGED",
            "RETRY_REISSUED",
            "MANUAL_REPLACEMENT"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "old_status": {
          "enum": [
            "STALE",
            "CANCELLED",
            "BLOCKED",
            "FAILED",
            "QUARANTINED"
          ]
        },
        "new_expected_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
