{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/nexy/control-plane/workers/worker-registry.schema.json",
  "title": "NEXY Control Plane Worker Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "workers"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "workers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/worker"
      }
    }
  },
  "$defs": {
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_id",
        "role",
        "capabilities",
        "allowed_scopes",
        "forbidden_scopes",
        "status",
        "max_concurrent_claims",
        "active_claim_ids",
        "trust_class",
        "human_gate_capability"
      ],
      "properties": {
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "AUDITOR",
            "BUILDER",
            "VERIFIER",
            "SCHEDULER",
            "EVIDENCE_INGESTOR",
            "RECOVERY"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowed_scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forbidden_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "BUSY",
            "DRAINING",
            "OFFLINE",
            "QUARANTINED"
          ]
        },
        "max_concurrent_claims": {
          "type": "integer",
          "minimum": 1
        },
        "active_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "trust_class": {
          "enum": [
            "STANDARD",
            "PRIVILEGED_REQUIRES_HUMAN_GATE"
          ]
        },
        "human_gate_capability": {
          "type": "boolean"
        },
        "metadata_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
