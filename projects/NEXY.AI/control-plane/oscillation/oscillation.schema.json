{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "type":"object","additionalProperties":false,
 "required":["detector_id","window","signal","occurrences","net_critical_delta","state","evidence_refs"],
 "properties":{
  "detector_id":{"type":"string","minLength":1},
  "window":{"type":"integer","minimum":2},
  "signal":{"enum":["FINDING_REOPEN","FILE_STATE_ALTERNATION","FIX_REGRESSION_LOOP","COMMAND_CLASS_REPEAT_FAIL","NO_CRITICAL_REDUCTION"]},
  "occurrences":{"type":"integer","minimum":1},
  "net_critical_delta":{"type":"integer"},
  "state":{"enum":["CLEAR","SUSPECTED","OSCILLATING"]},
  "evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
 }
}
