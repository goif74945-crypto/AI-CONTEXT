{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/nexy/playbook-registry.schema.json",
  "title": "NEXY Playbook Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "playbooks",
    "selection_rule",
    "fallback_rule"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "playbooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_type",
          "role",
          "path",
          "required_context",
          "proof_policy"
        ],
        "properties": {
          "task_type": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "BUILDER",
              "AUDITOR"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^projects/NEXY\\.AI/playbooks/(build|audit)/.+\\.md$"
          },
          "required_context": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proof_policy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "selection_rule": {
      "type": "string",
      "minLength": 1
    },
    "fallback_rule": {
      "type": "string",
      "minLength": 1
    }
  }
}
