{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/nexy/change-impact/change-impact-query.schema.json",
  "title": "NEXY First-Class Change Impact Query Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "source_change",
    "mapping",
    "recheck_before_pass",
    "unknowns",
    "status"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "source_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_type",
        "target_repo",
        "target_branch",
        "before_head",
        "after_head",
        "changed_files",
        "changed_symbols",
        "declared_subject_ids"
      ],
      "properties": {
        "change_type": {
          "enum": [
            "CODE",
            "CONFIG",
            "SCHEMA",
            "STATE",
            "PERMISSION",
            "CONTRACT",
            "REQUIREMENT_SPEC"
          ]
        },
        "target_repo": {
          "type": "string",
          "minLength": 1
        },
        "target_branch": {
          "type": "string",
          "minLength": 1
        },
        "before_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "after_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "changed_symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "declared_subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact",
        "candidate",
        "unknown"
      ],
      "properties": {
        "exact": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mappingItem"
          }
        },
        "candidate": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mappingItem"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unknownItem"
          }
        }
      }
    },
    "recheck_before_pass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "contracts",
        "fsms",
        "invariants",
        "state",
        "security",
        "events",
        "config",
        "dependents",
        "tests",
        "regression",
        "evidence_obligations"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "fsms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "state": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "security": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "config": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dependents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "regression": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_obligations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "PASS",
        "PARTIAL",
        "BLOCKED",
        "NOT_VERIFIED",
        "UNKNOWN"
      ]
    }
  },
  "$defs": {
    "mappingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certainty",
        "subject_id",
        "basis"
      ],
      "properties": {
        "certainty": {
          "enum": [
            "EXACT",
            "CANDIDATE",
            "UNKNOWN"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "unknownItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certainty",
        "subject",
        "reason"
      ],
      "properties": {
        "certainty": {
          "const": "UNKNOWN"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
