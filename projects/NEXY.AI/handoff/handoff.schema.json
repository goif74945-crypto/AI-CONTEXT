{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXY Cross-Chat Handoff Package",
  "type": "object",
  "required": [
    "chat_id",
    "role",
    "task",
    "implementation_snapshot",
    "scope",
    "input",
    "output",
    "claims",
    "proof",
    "tests",
    "changes",
    "findings",
    "unresolved",
    "next_action"
  ],
  "properties": {
    "chat_id": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "implementation_snapshot": {
      "type": "object"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "proof": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "next_action": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
