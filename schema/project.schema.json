{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/schema/project.schema.json",
  "title": "AI-CONTEXT Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "name",
    "status",
    "entrypoints",
    "authority_sources"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ACTIVE",
        "PAUSED",
        "BLOCKED",
        "ARCHIVED",
        "UNKNOWN"
      ]
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "authority_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "protected_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
