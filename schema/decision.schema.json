{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/schema/decision.schema.json",
  "title": "AI-CONTEXT Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "decision",
    "authority",
    "rationale"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PROPOSED",
        "LOCKED",
        "SUPERSEDED",
        "REJECTED",
        "CONFLICT"
      ]
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternatives_rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "option",
          "reason"
        ],
        "properties": {
          "option": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
