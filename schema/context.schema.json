{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/schema/context.schema.json",
  "title": "AI-CONTEXT Durable Context Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "status",
    "source_class",
    "summary",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "CANON",
        "PROJECT_STATE",
        "DECISION",
        "EVIDENCE",
        "FAILURE_PATTERN",
        "WORKFLOW",
        "PREFERENCE",
        "HISTORY",
        "EXPERIMENTAL",
        "DEPRECATED"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "DEPRECATED",
        "EXPERIMENTAL",
        "CONFLICT",
        "NOT_VERIFIED"
      ]
    },
    "source_class": {
      "enum": [
        "SOURCE_FACT",
        "REPO_FACT",
        "RUNTIME_FACT",
        "EXTERNAL_FACT",
        "INFERENCE",
        "ASSUMPTION",
        "UNKNOWN",
        "CONFLICT",
        "NOT_VERIFIED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": [
        "string",
        "object",
        "array",
        "null"
      ]
    },
    "authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
