{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/schema/memory.schema.json",
  "title": "AI-CONTEXT Memory Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "memory_class",
    "status",
    "summary",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "memory_class": {
      "enum": [
        "CANON",
        "PROJECT_STATE",
        "DECISION",
        "EVIDENCE",
        "FAILURE_PATTERN",
        "WORKFLOW",
        "PREFERENCE",
        "HISTORY",
        "EXPERIMENTAL",
        "DEPRECATED"
      ]
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "DEPRECATED",
        "EXPERIMENTAL",
        "CONFLICT",
        "NOT_VERIFIED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": [
        "string",
        "object",
        "array",
        "null"
      ]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retention": {
      "enum": [
        "DURABLE",
        "PROJECT_LIFETIME",
        "UNTIL_SUPERSEDED",
        "EXPERIMENTAL_DECAY"
      ]
    }
  }
}
