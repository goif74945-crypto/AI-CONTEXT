+                status: row.status,
+                attempts: row.attempts,
+                lastError: row.lastError,
+              },
+              policy: retryPolicy,
+            },
+          }
+        : {}),
+    });
+  } catch (error) {
+    const errorCode = dispatchErrorCode(error);
+    const marked = await prisma.directiveDispatch.updateMany({
+      where: expected,
+      data: {
+        status: DISPATCH_STATUS.FAILED,
+        attempts: { increment: 1 },
+        updatedTick: currentTick(),
+        lastError: errorCode,
+      },
+    });
+    if (marked.count !== 1) return observedAfterConflict();
+    return { status: DISPATCH_STATUS.FAILED, delivered: false, idempotent: false, errorCode };
+  }
+
+  const marked = await prisma.directiveDispatch.updateMany({
+    where: expected,
+    data: {
+      status: DISPATCH_STATUS.ENQUEUED,
+      attempts: { increment: 1 },
+      updatedTick: currentTick(),
+      // Elapsed-time authority is TSA milliseconds, not the logical event counter.
+      enqueuedTick: enqueuedAtMs,
+      lastError: null,
+    },
+  });
+  if (marked.count !== 1) return observedAfterConflict();
+  return {
+    status: DISPATCH_STATUS.ENQUEUED,
+    delivered: true,
+    idempotent: enqueueResult.idempotent,
+  };
