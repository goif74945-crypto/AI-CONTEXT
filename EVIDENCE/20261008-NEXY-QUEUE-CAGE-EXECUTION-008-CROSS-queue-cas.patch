+  // The producer's earlier snapshot is not authority after awaiting Redis.
+  // A losing producer must never revive a terminal/claimed durable state.
+  const expected = { id: row.id, status: row.status, attempts: row.attempts };
+  const observedAfterConflict = async (): Promise<DispatchAttemptResult> => {
+    const observed = await prisma.directiveDispatch.findUnique({
+      where: { id: row.id },
+      select: { status: true, lastError: true },
+    });
+    if (!observed) return { status: "MISSING", delivered: false, idempotent: true };
+    switch (observed.status) {
+      case DISPATCH_STATUS.COMPLETED:
+      case DISPATCH_STATUS.PROCESSING:
+      case DISPATCH_STATUS.ENQUEUED:
+        return { status: observed.status, delivered: true, idempotent: true };
+      case DISPATCH_STATUS.CANCELLED:
+      case DISPATCH_STATUS.PENDING:
+        return { status: observed.status, delivered: false, idempotent: true };
+      case DISPATCH_STATUS.FAILED:
+        return {
+          status: DISPATCH_STATUS.FAILED,
+          delivered: false,
+          idempotent: true,
+          ...(observed.lastError !== null ? { errorCode: observed.lastError } : {}),
+        };
+      default:
+        throw new Error("STATE_TRANSITION_DENIED: unknown dispatch status");
+    }
+  };
+
+  let enqueuedAtMs: bigint;
+  let enqueueResult: Awaited<ReturnType<typeof enqueueDirective>>;
+  // Catch only TSA/Redis publication failures, never database CAS failures.
+  try {
+    enqueuedAtMs = requireQueueAuthorityTimeMs();
+    enqueueResult = await enqueueDirective(jobData(row), {
+      idempotencyKey: row.idempotencyKey,
+      enqueuedAtMs,
+      ...(row.status === DISPATCH_STATUS.FAILED
+        ? {
+            retryAuthorization: {
