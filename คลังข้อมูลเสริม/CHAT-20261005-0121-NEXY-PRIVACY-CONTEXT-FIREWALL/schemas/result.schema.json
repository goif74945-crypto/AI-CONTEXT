{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.invalid/pcf/result.schema.json",
  "title": "NEXY PCF Result",
  "type": "object",
  "required": [
    "decision",
    "policy_version",
    "purpose",
    "destination",
    "payload",
    "leases",
    "field_decisions",
    "violations",
    "receipt"
  ],
  "properties": {
    "decision": {"enum": ["ALLOW", "FREEZE"]},
    "policy_version": {"type": ["string", "null"]},
    "purpose": {"type": ["string", "null"]},
    "destination": {"type": ["string", "null"]},
    "decision_time": {"type": "string"},
    "payload": {"type": ["object", "null"]},
    "leases": {"type": "array"},
    "field_decisions": {"type": "array"},
    "violations": {"type": "array"},
    "receipt": {
      "type": ["object", "null"],
      "properties": {
        "algorithm": {"const": "HMAC-SHA256"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["algorithm", "digest"]
    }
  }
}
