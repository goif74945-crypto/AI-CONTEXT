{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.invalid/pcf/context-envelope.schema.json",
  "title": "NEXY PCF Context Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "purpose",
    "destination",
    "decision_time",
    "required_fields",
    "fields"
  ],
  "properties": {
    "policy_version": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "minLength": 1},
    "decision_time": {"type": "string", "minLength": 1},
    "required_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "fields": {
      "type": "array",
      "items": {"$ref": "#/$defs/field"}
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "classification",
        "purposes",
        "allowed_destinations",
        "retention_seconds"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "value": {},
        "classification": {
          "enum": ["PUBLIC", "INTERNAL", "PERSONAL", "SENSITIVE", "SECRET", "CREDENTIAL"]
        },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_destinations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "retention_seconds": {"type": "integer", "minimum": 0}
      }
    }
  }
}
