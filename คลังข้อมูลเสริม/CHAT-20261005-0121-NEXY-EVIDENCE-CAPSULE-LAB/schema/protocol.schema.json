{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexy:lab:evidence-capsule:1",
  "title": "NEXY Evidence Capsule Lab Presentation",
  "type": "object",
  "required": ["header", "presentation"],
  "additionalProperties": false,
  "properties": {
    "header": {
      "type": "object",
      "required": ["protocol", "signature_algorithm", "record_id", "issuer", "key_id", "issued_at", "expires_at", "nonce", "field_count", "root", "signature", "capsule_id"],
      "properties": {
        "protocol": {"const": "NEXY-EVIDENCE-CAPSULE/1-LAB"},
        "signature_algorithm": {"const": "HMAC-SHA256-REFERENCE-ONLY"},
        "record_id": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "minLength": 1},
        "issued_at": {"type": "string"},
        "expires_at": {"type": "string"},
        "nonce": {"type": "string", "minLength": 1},
        "field_count": {"type": "integer", "minimum": 1},
        "root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capsule_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "required": ["capsule_id", "role", "purpose", "audience", "presented_at", "nonce", "disclosures", "signature", "presentation_id"],
      "properties": {
        "capsule_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "presented_at": {"type": "string"},
        "nonce": {"type": "string", "minLength": 1},
        "disclosures": {"type": "array", "minItems": 1},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "presentation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
