[
  {
    "name": "bounded local action is silent",
    "request": {"action_id": "read-context"},
    "expected_mode": "SILENT",
    "expected_events": []
  },
  {
    "name": "ambiguous reversible action previews",
    "request": {"action_id": "rename", "ambiguity": 0.4},
    "expected_mode": "PREVIEW",
    "expected_events": ["ACKNOWLEDGE", "INSPECT", "CANCEL"]
  },
  {
    "name": "authentication boundary confirms",
    "request": {"action_id": "grant-access", "crosses_auth_boundary": true},
    "expected_mode": "CONFIRM",
    "expected_events": ["APPROVE", "REJECT", "INSPECT"]
  },
  {
    "name": "irreversible destructive action freezes",
    "request": {
      "action_id": "delete-source",
      "destructive": true,
      "rollback_available": false,
      "reversibility": 0.0
    },
    "expected_mode": "FREEZE",
    "expected_events": ["REQUEST_REMEDIATION", "INSPECT"]
  }
]
