{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.invalid/schemas/nmdpc/disclosure-policy.schema.json",
  "title": "NMDPC Disclosure Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "rules"],
  "properties": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "capabilities", "recipient", "requested_retention_seconds"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "recipient": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recipient_id", "trust"],
          "properties": {
            "recipient_id": {"type": "string", "minLength": 1},
            "trust": {"enum": ["LOCAL_CORE", "TRUSTED_PROCESSOR", "EXTERNAL_MODEL", "UNKNOWN"]}
          }
        },
        "requested_retention_seconds": {"type": "integer", "minimum": 0},
        "consents": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_name", "classification", "allowed_purposes", "required_for_capabilities", "preferred_transform", "max_retention_seconds"],
        "properties": {
          "field_name": {"type": "string", "minLength": 1},
          "classification": {"enum": ["PUBLIC", "INTERNAL", "PRIVATE", "SECRET", "CREDENTIAL"]},
          "allowed_purposes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "required_for_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "recipient_value_required_for": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "preferred_transform": {"enum": ["NONE", "MASK", "TOKENIZE"]},
          "max_retention_seconds": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
