{
  "policy_id": "enterprise-authority-v1",
  "version": 1,
  "principals": [
    {"principal_id": "alice", "roles": ["OWNER"], "domains": ["DEPLOY", "FINANCE"], "active": true},
    {"principal_id": "bob", "roles": ["SECURITY"], "domains": ["DEPLOY"], "active": true},
    {"principal_id": "carol", "roles": ["OPERATOR"], "domains": ["DEPLOY"], "active": true},
    {"principal_id": "dave", "roles": ["OPERATOR"], "domains": ["DEPLOY"], "active": true},
    {"principal_id": "erin", "roles": ["FINANCE"], "domains": ["FINANCE"], "active": true}
  ],
  "rules": [
    {
      "rule_id": "deploy-production",
      "domain": "DEPLOY",
      "action": "PRODUCTION_RELEASE",
      "requester_roles": ["OWNER", "OPERATOR"],
      "approval_groups": [
        {"group_id": "security", "eligible_roles": ["SECURITY"], "threshold": 1},
        {"group_id": "operations", "eligible_roles": ["OWNER", "OPERATOR"], "threshold": 2}
      ],
      "veto_roles": ["OWNER", "SECURITY"],
      "deny_mode": "VETO_ROLES_ONLY",
      "requester_may_approve": false,
      "min_distinct_approvers": 3
    },
    {
      "rule_id": "finance-payout",
      "domain": "FINANCE",
      "action": "PAYOUT",
      "requester_roles": ["OWNER", "FINANCE"],
      "approval_groups": [
        {"group_id": "owner", "eligible_roles": ["OWNER"], "threshold": 1},
        {"group_id": "finance", "eligible_roles": ["FINANCE"], "threshold": 1}
      ],
      "veto_roles": ["OWNER"],
      "deny_mode": "ANY_ELIGIBLE_DENY",
      "requester_may_approve": false,
      "min_distinct_approvers": 2
    }
  ]
}
