{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:nexy:proposal:truth-surface-audit-report:1.0.0",
  "title":"NEXY Truth Surface Audit Report Proposal",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","conformant","violations","request_id","trace_id","backend_status","backend_state","role","certificate_fingerprint"],
  "properties":{
    "schema_version":{"const":"1.0.0-proposal"},
    "conformant":{"type":"boolean"},
    "violations":{"type":"array","items":{"$ref":"#/$defs/violation"}},
    "request_id":{"type":"string","minLength":1},
    "trace_id":{"type":"string","minLength":1},
    "backend_status":{"enum":["OK","DEGRADED","FREEZE","STOP"]},
    "backend_state":{"enum":["INIT","READY","RUNNING","VERIFYING","CONSENSUS","STABLE","FREEZE","STOP"]},
    "role":{"enum":["OWNER","OPERATOR","AUDITOR","SYSTEM","PUBLIC_USER"]},
    "certificate_fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  },
  "$defs":{
    "violation":{
      "type":"object",
      "additionalProperties":false,
      "required":["code","severity","path","message"],
      "properties":{
        "code":{"type":"string","minLength":1},
        "severity":{"enum":["ERROR","WARN"]},
        "path":{"type":"string","minLength":1},
        "message":{"type":"string","minLength":1}
      }
    }
  }
}
