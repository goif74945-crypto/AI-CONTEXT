{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/supplemental/ncik/commitment.schema.json",
  "title": "NCIK Commitment Reference Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["commitment_id","revision","issuer","beneficiary","objective","deliverable","scope","protected_scope","temporal_mode","effect","authority_state","authority_refs","required_evidence","binding"],
  "properties": {
    "commitment_id": {"type":"string","minLength":1},
    "revision": {"type":"integer","minimum":1},
    "issuer": {"type":"string","minLength":1},
    "beneficiary": {"type":"string","minLength":1},
    "objective": {"type":"string","minLength":1},
    "deliverable": {"type":"string","minLength":1},
    "scope": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "protected_scope": {"type":"array","items":{"type":"string","minLength":1}},
    "temporal_mode": {"enum":["IMMEDIATE","SCHEDULED","CONDITIONAL","RECURRING"]},
    "effect": {"enum":["READ_ONLY","REVERSIBLE_WRITE","EXTERNAL_SIDE_EFFECT","IRREVERSIBLE_WRITE"]},
    "authority_state": {"enum":["RESOLVED","UNRESOLVED","CONFLICT"]},
    "authority_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "required_evidence": {"type":"array","items":{"enum":["E0_PRESENCE","E1_STATIC","E2_UNIT","E3_INTEGRATION","E4_E2E","E5_RUNTIME","E6_DEPLOYMENT","E7_PHYSICAL"]}},
    "trigger_spec": {"type":["string","null"]},
    "deadline_spec": {"type":["string","null"]},
    "supersedes_fingerprint": {"type":["string","null"]},
    "binding": {"type":"object","additionalProperties":false,"required":["binding_type","binding_ref","durable","capability_proof_ref"],"properties":{"binding_type":{"enum":["INLINE_SESSION","SCHEDULED_TASK","CONDITION_WATCH","RECURRING_TASK"]},"binding_ref":{"type":"string","minLength":1},"durable":{"type":"boolean"},"capability_proof_ref":{"type":"string","minLength":1}}},
    "metadata":{"type":"object","additionalProperties":{"type":"string"}}
  }
}
