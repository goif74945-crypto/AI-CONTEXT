{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexy-ai-proposed:hicf:intent-envelope:v0",
  "title": "AI-PROPOSED HICF Intent Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective", "constraints", "immutables", "prohibited", "unknowns", "authority_state", "authority_refs"],
  "properties": {
    "objective": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "immutables": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "prohibited": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "materiality", "description"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "materiality": {"enum": ["NON_MATERIAL", "MATERIAL", "CRITICAL"]},
          "description": {"type": "string"}
        }
      }
    },
    "authority_state": {"enum": ["RESOLVED", "UNRESOLVED", "CONFLICT"]},
    "authority_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
