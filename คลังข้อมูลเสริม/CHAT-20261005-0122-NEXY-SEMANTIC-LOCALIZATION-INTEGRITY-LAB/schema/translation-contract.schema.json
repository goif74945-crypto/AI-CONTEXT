{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.ai/proposals/semantic-localization/translation-contract.schema.json",
  "title": "NEXY Semantic Localization Translation Contract",
  "type": "object",
  "required": ["source", "target", "sourceLanguage", "targetLanguage"],
  "properties": {
    "source": {"type": "string"},
    "target": {"type": "string"},
    "sourceLanguage": {"type": "string", "minLength": 2},
    "targetLanguage": {"type": "string", "minLength": 2},
    "protectedLiterals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
