{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.ai/proposals/semantic-localization/policy.schema.json",
  "title": "NEXY Semantic Localization Integrity Policy",
  "type": "object",
  "required": ["policyVersion", "mode", "supportedLanguages", "preserve", "canonicalTokens", "protectedLiterals", "severity"],
  "properties": {
    "policyVersion": {"type": "string", "minLength": 1},
    "mode": {"enum": ["strict"]},
    "supportedLanguages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "freezeOnUnsupportedLanguage": {"type": "boolean"},
    "preserve": {
      "type": "object",
      "required": ["numbers", "units", "placeholders", "urls", "emails", "identifiers", "canonicalTokens", "modality", "negation"],
      "additionalProperties": false,
      "properties": {
        "numbers": {"type": "boolean"},
        "units": {"type": "boolean"},
        "placeholders": {"type": "boolean"},
        "urls": {"type": "boolean"},
        "emails": {"type": "boolean"},
        "identifiers": {"type": "boolean"},
        "canonicalTokens": {"type": "boolean"},
        "modality": {"type": "boolean"},
        "negation": {"type": "boolean"}
      }
    },
    "canonicalTokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "protectedLiterals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowAdditionalCanonicalTokens": {"type": "boolean"},
    "severity": {"type": "object"}
  },
  "additionalProperties": false
}
