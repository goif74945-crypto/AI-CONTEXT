{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nexy/authority-lease.schema.json",
  "title": "NEXY Authority Lease (AI-proposed reference)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease_id", "subject", "allowed_resource_patterns", "allowed_verbs",
    "allowed_effects", "max_cost_units", "max_actions", "issued_at_tick",
    "expires_at_tick", "plan_hash", "policy_version", "allow_high_impact"
  ],
  "properties": {
    "lease_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "allowed_resource_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "allowed_verbs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "allowed_effects": {"type": "array", "minItems": 1, "items": {"enum": ["READ", "REVERSIBLE_WRITE", "IRREVERSIBLE_WRITE", "EXTERNAL_SIDE_EFFECT"]}},
    "max_cost_units": {"type": "integer", "minimum": 0},
    "max_actions": {"type": "integer", "minimum": 1},
    "issued_at_tick": {"type": "integer", "minimum": 0},
    "expires_at_tick": {"type": "integer", "minimum": 0},
    "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_version": {"type": "string", "minLength": 1},
    "allow_high_impact": {"type": "boolean"},
    "parent_lease_id": {"type": ["string", "null"]}
  }
}
