{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nexy/action-plan.schema.json",
  "title": "NEXY Action Plan (AI-proposed reference)",
  "type": "object",
  "additionalProperties": false,
  "required": ["actions"],
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "verb", "effect", "destination", "cost_units"],
        "properties": {
          "resource": {"type": "string", "minLength": 1},
          "verb": {"type": "string", "minLength": 1},
          "effect": {"enum": ["READ", "REVERSIBLE_WRITE", "IRREVERSIBLE_WRITE", "EXTERNAL_SIDE_EFFECT"]},
          "destination": {"type": ["string", "null"]},
          "cost_units": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
