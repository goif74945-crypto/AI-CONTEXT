{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.invalid/schemas/experimental/wocf-evaluation-result.schema.json",
  "title": "WOCF Experimental Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "proposal_hash", "catalog_hash", "policy_hash", "compared_workstreams", "max_lexical_overlap", "max_overlap_workstream_id", "findings"],
  "properties": {
    "decision": {"enum": ["ALLOW", "WARN", "FREEZE"]},
    "proposal_hash": {"type": "string"},
    "catalog_hash": {"type": "string"},
    "policy_hash": {"type": "string"},
    "compared_workstreams": {"type": "integer", "minimum": 0},
    "max_lexical_overlap": {"type": "number", "minimum": 0, "maximum": 1},
    "max_overlap_workstream_id": {"type": ["string", "null"]},
    "findings": {"type": "array"}
  }
}
