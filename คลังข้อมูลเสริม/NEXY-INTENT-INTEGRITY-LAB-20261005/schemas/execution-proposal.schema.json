{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nexy/execution-proposal.schema.json",
  "title": "NEXY Intent Integrity Lab Execution Proposal",
  "description": "AI-PROPOSED CONCEPT research schema. Not a current NEXY.AI requirement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id","target_repository","touch_paths","covered_requirement_ids","evidence","resolved_unknowns","claims"],
  "properties": {
    "proposal_id":{"type":"string","minLength":1},
    "touch_paths":{"$ref":"#/$defs/uniqueStringArray"},
    "covered_requirement_ids":{"$ref":"#/$defs/uniqueStringArray"},
    "resolved_unknowns":{"$ref":"#/$defs/uniqueStringArray"},
    "evidence":{
      "type":"object",
      "additionalProperties":{"enum":["none","inspection","static","unit","integration","e2e","runtime","deployment","physical"]}
    },
    "claims":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","truth_class","basis"],
        "properties":{
          "id":{"type":"string","minLength":1},
          "truth_class":{"enum":["SOURCE_FACT","REPO_FACT","RUNTIME_FACT","EXTERNAL_FACT","INFERENCE","ASSUMPTION","UNKNOWN","NOT_VERIFIED"]},
          "basis":{"type":"string","minLength":1},
          "completion_claim":{"type":"boolean","default":false}
        }
      }
    },
    "target_repository":{"type":"string","minLength":1}
  },
  "$defs":{
    "uniqueStringArray":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}
