{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AI-Proposed NCMDE Mission Intent v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","mission_id","objective","domains","capabilities","deliverables","write_claims","protected_claims","exclusive_resources","exclusive_authorities","started_at","lease_expires_at","status"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "mission_id":{"type":"string","minLength":1},
    "objective":{"type":"string","minLength":1},
    "domains":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "deliverables":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "write_claims":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/claim"}},
    "protected_claims":{"type":"array","items":{"$ref":"#/$defs/claim"}},
    "exclusive_resources":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "exclusive_authorities":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "started_at":{"type":"string","format":"date-time"},
    "lease_expires_at":{"type":"string","format":"date-time"},
    "status":{"enum":["DRAFT","ACTIVE","COMPLETED","CANCELLED"]}
  },
  "$defs":{
    "claim":{
      "type":"object","additionalProperties":false,"required":["path","kind"],
      "properties":{"path":{"type":"string","minLength":1},"kind":{"enum":["FILE","TREE"]}}
    }
  }
}