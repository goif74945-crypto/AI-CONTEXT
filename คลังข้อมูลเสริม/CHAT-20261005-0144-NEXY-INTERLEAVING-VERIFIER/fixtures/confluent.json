{
  "schema_version": "1.0",
  "initial_state": {"counter": 0, "audit": []},
  "actions": [
    {
      "id": "worker-a",
      "effects": [
        {"op": "add", "path": "/counter", "value": 1}
      ]
    },
    {
      "id": "worker-b",
      "effects": [
        {"op": "add", "path": "/counter", "value": 2}
