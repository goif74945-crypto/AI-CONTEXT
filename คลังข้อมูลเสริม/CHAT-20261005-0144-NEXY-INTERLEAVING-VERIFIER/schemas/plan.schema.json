{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.ai/proposals/interleaving-verifier-plan.schema.json",
  "title": "AI-Proposed Deterministic Interleaving Verifier Plan",
  "type": "object",
  "required": ["initial_state", "actions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0", "default": "1.0"},
    "initial_state": {"$ref": "#/$defs/jsonObject"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/action"}
    },
    "invariants": {
      "type": "array",
      "items": {"$ref": "#/$defs/predicate"},
      "default": []
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_states": {"type": "integer", "minimum": 1, "default": 50000},
        "max_transitions": {"type": "integer", "minimum": 1, "default": 250000}
      },
      "default": {}
    }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {"$ref": "#/$defs/jsonObject"}
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "pointer": {"type": "string", "pattern": "^/"},
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "path"],
          "additionalProperties": false,
          "properties": {
            "op": {"enum": ["exists", "not_exists", "unique"]},
            "path": {"$ref": "#/$defs/pointer"}
          }
        },
        {
          "type": "object",
          "required": ["op", "path", "value"],
          "additionalProperties": false,
          "properties": {
            "op": {"enum": ["eq", "neq"]},
            "path": {"$ref": "#/$defs/pointer"},
            "value": {"$ref": "#/$defs/jsonValue"}
          }
        },
        {
          "type": "object",
          "required": ["op", "path"],
          "additionalProperties": false,
          "properties": {
            "op": {"const": "int_range"},
            "path": {"$ref": "#/$defs/pointer"},
            "min": {"type": "integer"},
            "max": {"type": "integer"}
          },
          "anyOf": [
            {"required": ["min"]},
            {"required": ["max"]}
          ]
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "path", "value"],
          "additionalProperties": false,
          "properties": {
            "op": {"const": "set"},
            "path": {"$ref": "#/$defs/pointer"},
            "value": {"$ref": "#/$defs/jsonValue"}
          }
        },
        {
          "type": "object",
          "required": ["op", "path", "value"],
          "additionalProperties": false,
          "properties": {
            "op": {"const": "add"},
            "path": {"$ref": "#/$defs/pointer"},
            "value": {"type": "integer"}
          }
        },
        {
          "type": "object",
          "required": ["op", "from", "to"],
          "additionalProperties": false,
          "properties": {
            "op": {"const": "copy"},
            "from": {"$ref": "#/$defs/pointer"},
            "to": {"$ref": "#/$defs/pointer"}
          }
        },
        {
          "type": "object",
          "required": ["op", "path"],
          "additionalProperties": false,
          "properties": {
            "op": {"const": "delete"},
            "path": {"$ref": "#/$defs/pointer"}
          }
        },
        {
          "type": "object",
          "required": ["op", "path", "value"],
          "additionalProperties": false,
          "properties": {
            "op": {"const": "append_unique"},
            "path": {"$ref": "#/$defs/pointer"},
            "value": {"$ref": "#/$defs/jsonValue"}
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "required": ["id", "effects"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "default": []
        },
        "requires": {
          "type": "array",
          "items": {"$ref": "#/$defs/predicate"},
          "default": []
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/effect"}
        }
      }
    }
  }
}
