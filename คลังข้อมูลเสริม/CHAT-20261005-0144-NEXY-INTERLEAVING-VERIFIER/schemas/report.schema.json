{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.ai/proposals/interleaving-verifier-report.schema.json",
  "title": "AI-Proposed Deterministic Interleaving Verifier Report",
  "type": "object",
  "required": [
    "report_version",
    "verification_status",
    "decision",
    "exploration_complete",
    "states_explored",
    "transitions_explored",
    "terminal_state_count",
    "terminal_fingerprints",
    "static_conflicts",
    "witnesses",
    "diagnostics",
    "report_fingerprint"
  ],
  "properties": {
    "report_version": {"const": "1.0"},
    "verification_status": {"enum": ["PASS", "FAIL", "NOT_VERIFIED"]},
    "decision": {
      "enum": [
        "CONFLUENT",
        "DIVERGENT_TERMINAL_STATE",
        "PRECONDITION_FAILURE",
        "INVARIANT_VIOLATION",
        "EXECUTION_MODEL_ERROR",
        "NO_TERMINAL_STATE",
        "FREEZE_INVALID_INPUT",
        "FREEZE_LIMIT"
      ]
    },
    "plan_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "report_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exploration_complete": {"type": "boolean"},
    "states_explored": {"type": "integer", "minimum": 0},
    "transitions_explored": {"type": "integer", "minimum": 0},
    "terminal_state_count": {"type": "integer", "minimum": 0},
    "terminal_fingerprints": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "static_conflicts": {"type": "array", "items": {"type": "object"}},
    "witnesses": {"type": "array", "items": {"type": "object"}},
    "diagnostics": {"type": "array", "items": {"type": "object"}},
    "canonical_terminal_state": {"type": "object"},
    "canonical_schedule_witness": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
