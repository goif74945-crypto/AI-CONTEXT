{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.example/spec/neik/input-envelope.schema.json",
  "title": "NEIK input envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim", "policy", "evidence"],
  "properties": {
    "schema_version": {"const": "neik/0.1"},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_revision", "required_evidence_class", "required_independent_confirmations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "target_revision": {"type": "string", "minLength": 1},
        "required_evidence_class": {"enum": ["E0","E1","E2","E3","E4","E5","E6","E7"]},
        "required_independent_confirmations": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independence_dimensions", "require_blind", "forbid_self_verification_without_external_oracle", "max_evidence_nodes", "max_solver_states"],
      "properties": {
        "independence_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["source_lineage","producer_lineage","oracle_lineage"]}
        },
        "require_blind": {"type": "boolean"},
        "forbid_self_verification_without_external_oracle": {"type": "boolean"},
        "max_evidence_nodes": {"type": "integer", "minimum": 1, "maximum": 128},
        "max_solver_states": {"type": "integer", "minimum": 1, "maximum": 10000000}
      }
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","claim_id","target_revision","evidence_class","verdict","producer_id","subjects_under_test","external_oracle","blind","derived_from","source_lineage","producer_lineage","oracle_lineage","artifact_hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "claim_id": {"type": "string", "minLength": 1},
        "target_revision": {"type": "string", "minLength": 1},
        "evidence_class": {"enum": ["E0","E1","E2","E3","E4","E5","E6","E7"]},
        "verdict": {"enum": ["PASS","FAIL"]},
        "producer_id": {"type": "string", "minLength": 1},
        "subjects_under_test": {"$ref": "#/$defs/stringSet"},
        "external_oracle": {"type": "boolean"},
        "blind": {"type": "boolean"},
        "derived_from": {"$ref": "#/$defs/stringSet"},
        "source_lineage": {"$ref": "#/$defs/stringSet"},
        "producer_lineage": {"$ref": "#/$defs/stringSet"},
        "oracle_lineage": {"$ref": "#/$defs/stringSet"},
        "artifact_hash": {"type": "string", "minLength": 1}
      }
    }
  }
}