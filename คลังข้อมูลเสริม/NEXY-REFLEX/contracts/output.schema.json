{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.local/reflex/output.schema.json",
  "title": "NEXY-REFLEX Gate Decision",
  "type": "object",
  "required": ["verdict", "action", "input_digest", "decision_digest", "effective_requirements", "non_gating_requirements", "findings"],
  "properties": {
    "verdict": {"enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED", "NOT_VERIFIED", "UNKNOWN", "CONFLICT"]},
    "action": {"enum": ["ACCEPT_ADVISORY", "FREEZE_RECOMMENDED"]},
    "input_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "effective_requirements": {"type": "array", "items": {"type": "string"}},
    "non_gating_requirements": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
