{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.local/reflex/input.schema.json",
  "title": "NEXY-REFLEX Snapshot",
  "type": "object",
  "required": ["snapshot_version", "target", "authority_order", "requirements", "evidence"],
  "properties": {
    "snapshot_version": {"const": "1.0"},
    "target": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "content_digest": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": true
    },
    "authority_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "key", "value", "authority", "scope", "accepted_evidence_classes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "value": true,
        "authority": {"type": "string", "minLength": 1},
        "scope": {"enum": ["CURRENT_GOVERNING_LAW", "CURRENT_BUILD", "CURRENT_BUILD_SUPPLEMENT", "SUPPORTED_PRODUCT_DESIGN", "DEPLOYMENT_EVIDENCE", "EXCLUDED_CURRENT", "DEFERRED_FUTURE"]},
        "accepted_evidence_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7"]}
        },
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["id", "requirement_id", "class", "status", "target_revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "requirement_id": {"type": "string", "minLength": 1},
        "class": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7"]},
        "status": {"enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED", "NOT_VERIFIED", "UNKNOWN", "CONFLICT"]},
        "target_revision": {"type": "string", "minLength": 1},
        "target_digest": {"type": ["string", "null"], "minLength": 1},
        "provenance": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
