{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexy-proofgraph/link-graph.schema.json",
  "title": "NEXY ProofGraph Link Graph",
  "type": "object",
  "required": ["schema", "nodes", "edges"],
  "properties": {
    "schema": {"const": "nexy-proofgraph/link-graph"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size", "kind"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "kind": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "relation", "line"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "relation": {"const": "markdown-link"},
          "line": {"type": ["integer", "null"], "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
