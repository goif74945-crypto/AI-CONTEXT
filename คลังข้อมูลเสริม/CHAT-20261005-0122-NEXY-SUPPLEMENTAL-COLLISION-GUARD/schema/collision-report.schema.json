{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nexy/supplemental-collision-guard/collision-report.schema.json",
  "title": "Supplemental Collision Guard Check Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate",
    "classification",
    "top_score",
    "top_matches",
    "decision_guidance"
  ],
  "properties": {
    "schema": {
      "const": "supplemental-collision-guard/v1"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "terms", "tags"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "terms": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "classification": {
      "enum": ["DISTINCT", "RELATED", "HIGH_OVERLAP", "LIKELY_DUPLICATE"]
    },
    "top_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "top_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "path",
          "score",
          "shared_terms",
          "shared_tags",
          "term_jaccard",
          "candidate_containment",
          "tag_jaccard"
        ],
        "properties": {
          "project": {"type": "string"},
          "path": {"type": "string"},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "shared_terms": {"type": "array", "items": {"type": "string"}},
          "shared_tags": {"type": "array", "items": {"type": "string"}},
          "term_jaccard": {"type": "number", "minimum": 0, "maximum": 1},
          "candidate_containment": {"type": "number", "minimum": 0, "maximum": 1},
          "tag_jaccard": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "decision_guidance": {"type": "string", "minLength": 1}
  }
}
