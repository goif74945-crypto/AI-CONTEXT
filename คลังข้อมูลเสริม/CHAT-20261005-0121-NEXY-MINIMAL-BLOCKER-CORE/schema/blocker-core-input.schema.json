{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-context.local/experimental/nexy-mbc/input.schema.json",
  "title": "NEXY Minimal Blocker Core Input v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "certificate_id", "target", "evidence", "gate"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "certificate_id": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "metadata": {"type": "object"},
    "evidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/evidenceLeaf"}
    },
    "gate": {"$ref": "#/$defs/gate"}
  },
  "$defs": {
    "evidenceClass": {
      "enum": ["E0_PRESENCE", "E1_STATIC", "E2_UNIT", "E3_INTEGRATION", "E4_E2E", "E5_RUNTIME", "E6_DEPLOYMENT", "E7_PHYSICAL"]
    },
    "evidenceLeaf": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_VERIFIED", "UNKNOWN", "CONFLICT"]},
        "required_class": {"$ref": "#/$defs/evidenceClass"},
        "observed_class": {"$ref": "#/$defs/evidenceClass"},
        "target_revision": {"type": ["string", "null"], "minLength": 1},
        "observed_revision": {"type": ["string", "null"], "minLength": 1},
        "repair_cost": {"type": "number", "minimum": 0},
        "repair_kind": {"enum": ["EVIDENCE", "IMPLEMENTATION", "AUTHORITY", "DEPENDENCY", "REVIEW", "OTHER"]},
        "remediation": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "gate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["leaf"],
          "properties": {"leaf": {"type": "string", "minLength": 1}, "label": {"type": ["string", "null"], "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all_of"],
          "properties": {"all_of": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}}, "label": {"type": ["string", "null"], "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any_of"],
          "properties": {"any_of": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}}, "label": {"type": ["string", "null"], "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["at_least"],
          "properties": {
            "label": {"type": ["string", "null"], "minLength": 1},
            "at_least": {
              "type": "object",
              "additionalProperties": false,
              "required": ["k", "of"],
              "properties": {
                "k": {"type": "integer", "minimum": 1},
                "of": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}}
              }
            }
          }
        }
      ]
    }
  }
}
