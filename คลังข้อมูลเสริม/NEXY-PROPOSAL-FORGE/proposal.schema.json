{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nexy-proposal-forge/proposal.schema.json",
  "title": "NEXY Proposal Forge Candidate Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "version",
    "status",
    "title",
    "summary",
    "problem",
    "intended_users",
    "user_outcomes",
    "proposed_capabilities",
    "integration_surfaces",
    "non_goals",
    "risks",
    "assumptions",
    "authority_references",
    "evidence",
    "authority_conflicts"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "AI_PROPOSED_CONCEPT"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "intended_users": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "user_outcomes": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "proposed_capabilities": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "integration_surfaces": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "non_goals": {
      "$ref": "#/$defs/stringArray"
    },
    "risks": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "assumptions": {
      "$ref": "#/$defs/stringArray"
    },
    "authority_references": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "authority_conflicts": {
      "$ref": "#/$defs/stringArray"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "role",
        "truth_class",
        "claim",
        "locator"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "minLength": 1
        },
        "truth_class": {
          "enum": [
            "SOURCE_FACT",
            "REPO_FACT",
            "RUNTIME_FACT",
            "EXTERNAL_FACT",
            "INFERENCE",
            "ASSUMPTION",
            "UNKNOWN",
            "NOT_VERIFIED"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "AUTHORITY",
            "DUPLICATE_CHECK",
            "USER_VALUE",
            "RISK",
            "ASSUMPTION",
            "OTHER"
          ]
        }
      }
    }
  }
}
