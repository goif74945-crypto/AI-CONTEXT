{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nexy-def/prepared-action.schema.json",
  "title": "NEXY DEF Prepared Action Reference Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["action_id", "kind", "payload", "action_digest", "prepared_epoch", "directive_hash", "lineage_hash"],
  "properties": {
    "action_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["READ", "REVERSIBLE_WRITE", "IRREVERSIBLE_WRITE"]},
    "payload": {"type": "object"},
    "action_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prepared_epoch": {"type": "integer", "minimum": 1},
    "directive_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lineage_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_binding": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
