{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nexy-def/journal-record.schema.json",
  "title": "NEXY DEF Journal Record Reference Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["index", "kind", "payload", "outcome_code", "resulting_state_hash", "previous_record_hash", "record_hash"],
  "properties": {
    "index": {"type": "integer", "minimum": 0},
    "kind": {"enum": ["DIRECTIVE", "COMMIT", "RECOVERY"]},
    "payload": {"type": "object"},
    "outcome_code": {"type": "string", "minLength": 1},
    "resulting_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
