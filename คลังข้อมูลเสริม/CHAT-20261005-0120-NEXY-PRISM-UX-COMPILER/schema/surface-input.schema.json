{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexy:prism:surface-input:v0.1",
  "title": "NEXY::PRISM SurfaceInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "system_state", "role", "evidence_status", "requested_action", "risk",
    "preferred_detail", "backend_authorized", "release_authorized",
    "recoverable", "irreversible"
  ],
  "properties": {
    "system_state": {"enum": ["INIT", "READY", "RUNNING", "VERIFYING", "CONSENSUS", "STABLE", "FREEZE", "STOP"]},
    "role": {"enum": ["OWNER", "OPERATOR", "AUDITOR", "SYSTEM", "PUBLIC_USER"]},
    "evidence_status": {"enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED", "NOT_VERIFIED", "UNKNOWN", "CONFLICT"]},
    "requested_action": {"enum": ["VIEW_RESULT", "OPEN_TRACE", "SUBMIT_DIRECTIVE", "RECOVER_FREEZE", "EXPORT_ARTIFACT", "EXPORT_AUDIT", "CONFIG_CHANGE", "HARD_DELETE"]},
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "preferred_detail": {"enum": ["COMPACT", "STANDARD", "FORENSIC"]},
    "backend_authorized": {"type": "boolean"},
    "release_authorized": {"type": "boolean"},
    "recoverable": {"type": "boolean"},
    "irreversible": {"type": "boolean"},
    "incident_code": {"type": ["string", "null"]},
    "blocking_layer": {"type": ["string", "null"]},
    "backend_reason_code": {"type": ["string", "null"]}
  }
}
