{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexy:ai-proposed:context-release-firewall:1.0",
  "title": "AI-Proposed NEXY Context Release Firewall Interchange Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "policy", "context"],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "consumer_id", "purpose", "required_keys", "optional_keys", "allowed_compartments"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "consumer_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "required_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "optional_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "allowed_compartments": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "consumer_id", "allowed_purposes", "max_sensitivity", "allowed_compartments", "allow_declassification"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "consumer_id": {"type": "string", "minLength": 1},
        "allowed_purposes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "max_sensitivity": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "PRIVATE", "SECRET", "RESTRICTED"]},
        "allowed_compartments": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "allow_declassification": {"type": "boolean"}
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value", "sensitivity", "provenance", "compartments", "allowed_purposes", "derived_from"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "value": {},
          "sensitivity": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "PRIVATE", "SECRET", "RESTRICTED"]},
          "provenance": {"type": "string", "minLength": 1},
          "compartments": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "allowed_purposes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "derived_from": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "expires_at": {"type": ["string", "null"]}
        }
      }
    }
  }
}
