{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.ai/proposals/resource-governor.schema.json",
  "title": "AI-Proposed NEXY Proof-Preserving Resource Governor Contract",
  "type": "object",
  "required": [
    "task",
    "agents"
  ],
  "additionalProperties": false,
  "properties": {
    "task": {
      "$ref": "#/$defs/task"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/agent"
      }
    }
  },
  "$defs": {
    "dataClass": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "riskTier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "task": {
      "type": "object",
      "required": [
        "task_id",
        "required_capabilities",
        "data_class",
        "risk_tier",
        "required_evidence_class",
        "worker_input_tokens",
        "worker_output_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data_class": {
          "$ref": "#/$defs/dataClass"
        },
        "risk_tier": {
          "$ref": "#/$defs/riskTier"
        },
        "required_evidence_class": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "worker_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "worker_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "verifier_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "verifier_output_tokens": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "require_independent_verifier": {
          "type": "boolean",
          "default": false
        },
        "min_quality_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "default": 0
        },
        "max_total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_cost_microunits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "worker_input_tokens": {
                  "minimum": 1
                }
              }
            },
            {
              "properties": {
                "worker_output_tokens": {
                  "minimum": 1
                }
              }
            }
          ]
        }
      ]
    },
    "agent": {
      "type": "object",
      "required": [
        "agent_id",
        "provider_domain",
        "roles",
        "capabilities",
        "clearance",
        "max_context_tokens",
        "input_cost_microunits_per_1k",
        "output_cost_microunits_per_1k",
        "estimated_latency_ms",
        "quality_bps",
        "max_evidence_class"
      ],
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_domain": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "worker",
              "verifier"
            ]
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "clearance": {
          "$ref": "#/$defs/dataClass"
        },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "input_cost_microunits_per_1k": {
          "type": "integer",
          "minimum": 0
        },
        "output_cost_microunits_per_1k": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "quality_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "max_evidence_class": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "active": {
          "type": "boolean",
          "default": true
        },
        "quarantined": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
