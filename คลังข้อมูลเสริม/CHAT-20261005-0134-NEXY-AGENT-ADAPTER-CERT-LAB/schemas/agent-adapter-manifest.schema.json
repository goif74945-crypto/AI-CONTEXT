{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.local/labs/agent-adapter-cert/manifest.schema.json",
  "title": "NEXY AgentAdapter Preflight Manifest",
  "description": "AI-proposed standalone lab schema; not a canonical NEXY.AI production schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter", "authority", "security"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "version", "supported_modes", "deterministic_capable", "critical", "timeout_ms", "context_capacity", "operations"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
        "provider": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 5},
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["fast", "strict", "audit"]}
        },
        "deterministic_capable": {"type": "boolean"},
        "critical": {"type": "boolean"},
        "timeout_ms": {"type": "integer", "minimum": 10000, "maximum": 60000},
        "context_capacity": {"type": "integer", "minimum": 1},
        "operations": {
          "type": "array",
          "items": {"type": "string"},
          "allOf": [
            {"contains": {"const": "execute"}},
            {"contains": {"const": "cancel"}},
            {"contains": {"const": "healthcheck"}}
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_only", "direct_release", "direct_vault_write", "mutates_core_state", "automatic_retry"],
      "properties": {
        "candidate_only": {"const": true},
        "direct_release": {"const": false},
        "direct_vault_write": {"const": false},
        "mutates_core_state": {"const": false},
        "automatic_retry": {"const": false}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_delivery", "persists_secrets"],
      "properties": {
        "secret_delivery": {"const": "runtime_injection"},
        "persists_secrets": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"adapter": {"properties": {"critical": {"const": true}}}}},
      "then": {"properties": {"adapter": {"properties": {"timeout_ms": {"const": 30000}}}}}
    }
  ]
}
