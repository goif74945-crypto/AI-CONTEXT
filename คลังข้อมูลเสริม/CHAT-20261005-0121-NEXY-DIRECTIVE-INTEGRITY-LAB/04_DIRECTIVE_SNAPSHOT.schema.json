{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.local/schemas/directive-integrity-v1.json",
  "title": "NEXY Directive Integrity Snapshot and Authorization",
  "description": "AI-proposed experimental schema for the standalone semantic-continuity lab; not canonical NEXY law.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "uniqueStrings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonBlank"
      },
      "uniqueItems": true
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "stage",
        "action",
        "target",
        "constraints",
        "scope_in",
        "scope_out",
        "side_effects",
        "authority_refs",
        "ambiguity",
        "clarification_refs",
        "mutation_class",
        "impact_class",
        "risk_reassessment_refs",
        "parent_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "nexy.directive-integrity.v1"
        },
        "stage": {
          "$ref": "#/$defs/nonBlank"
        },
        "action": {
          "$ref": "#/$defs/nonBlank"
        },
        "target": {
          "$ref": "#/$defs/nonBlank"
        },
        "constraints": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "scope_in": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "scope_out": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "side_effects": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "authority_refs": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "ambiguity": {
          "enum": [
            "RESOLVED",
            "OPEN"
          ]
        },
        "clarification_refs": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "mutation_class": {
          "enum": [
            "READ_ONLY",
            "REVERSIBLE_MUTATION",
            "IRREVERSIBLE_MUTATION"
          ]
        },
        "impact_class": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "risk_reassessment_refs": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "parent_digest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "evidence_ref",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^ ]+"
        },
        "evidence_ref": {
          "$ref": "#/$defs/nonBlank"
        },
        "reason": {
          "$ref": "#/$defs/nonBlank"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/authorization"
    }
  ]
}
