{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nexy/haiil/evaluation-report.schema.json",
  "title": "AI-Proposed NEXY Interaction Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "decision", "presentation"],
  "properties": {
    "scenario_id": { "type": "string", "minLength": 1 },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_codes", "questions", "contract_hash", "action_hash"],
      "properties": {
        "status": { "enum": ["ALLOW", "ASK", "FREEZE"] },
        "reason_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "questions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "contract_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "action_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "presentation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "violations"],
          "properties": {
            "status": { "enum": ["PASS", "FAIL", "NOT_VERIFIED"] },
            "violations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    }
  }
}
