{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nexy/haiil/intent-contract.schema.json",
  "title": "AI-Proposed NEXY Intent Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "objective", "mode", "actor", "constraints", "required_outcomes", "material_fields"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["VIEW", "RUN", "FORGE"] },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["OWNER", "OPERATOR", "AUDITOR", "SYSTEM"] },
        "declared_expertise": { "enum": ["NEW", "STANDARD", "ADVANCED"] }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_scope", "protected_scope", "allow_external", "max_interruptions"],
      "properties": {
        "allowed_scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "protected_scope": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "allow_external": { "type": "boolean" },
        "max_interruptions": { "type": "integer", "minimum": 0 }
      }
    },
    "required_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "material_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "present", "prompt"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "present": { "type": "boolean" },
          "prompt": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
