{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.example/research/ixlab/decision-context.schema.json",
  "title": "IX-Lab Decision Context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "authority_conflict": {"type": "boolean"},
    "missing_required_information": {"type": "boolean"},
    "evidence_required": {"type": "boolean"},
    "evidence_sufficient": {"type": "boolean"},
    "action_reversible": {"type": "boolean"},
    "action_preauthorized": {"type": "boolean"},
    "confirmation_required_by_law": {"type": "boolean"},
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}
  }
}
