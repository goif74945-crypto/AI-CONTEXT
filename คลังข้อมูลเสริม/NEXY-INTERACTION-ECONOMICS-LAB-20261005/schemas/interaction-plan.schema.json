{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexy.example/research/ixlab/interaction-plan.schema.json",
  "title": "IX-Lab Interaction Plan",
  "type": "object",
  "required": ["steps"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_friction_score": {"type": "number", "minimum": 0, "maximum": 100},
        "max_blocking_touches": {"type": "integer", "minimum": 0},
        "max_choice_bits": {"type": "number", "minimum": 0},
        "max_context_switches": {"type": "integer", "minimum": 0},
        "max_wait_ms": {"type": "integer", "minimum": 0}
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": ["automatic", "information", "clarification", "confirmation", "selection", "wait", "irreversible_action", "freeze"]
          },
          "blocking": {"type": "boolean"},
          "required": {"type": "boolean"},
          "choice_count": {"type": "integer", "minimum": 0},
          "estimated_wait_ms": {"type": "integer", "minimum": 0},
          "context_switches": {"type": "integer", "minimum": 0},
          "user_effort": {"type": "number", "minimum": 0, "maximum": 5},
          "reversible": {"type": "boolean"},
          "preauthorized": {"type": "boolean"},
          "required_by_law": {"type": "boolean"},
          "guards_step_id": {"type": ["string", "null"]},
          "justification": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
