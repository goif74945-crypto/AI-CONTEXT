{
  "policy_id": "nexy-ai-context-supplemental-example-v1",
  "allowed_boundaries": [
    "AI_CONTEXT",
    "EXTERNAL_SANDBOX"
  ],
  "protected_resources": [
    "repo:NEXY.AI/**",
    "repo:*NEXY.AI*/**",
    "secret:**",
    "production:**"
  ],
  "max_steps": 64,
  "require_postcondition_for_mutation": true,
  "require_evidence_for_mutation": true,
  "require_idempotency_for_external": true,
  "allow_terminal_irreversible_with_approval": true
}
