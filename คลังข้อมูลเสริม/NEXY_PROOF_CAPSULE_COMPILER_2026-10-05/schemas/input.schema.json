{
  "$id": "https://nexy.invalid/proposals/proof-capsule/input-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {"format": "date-time", "type": "string"},
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "accepted": {"items": {"enum": ["E0","E1","E2","E3","E4","E5","E6","E7"]}, "minItems": 1, "type": "array", "uniqueItems": true},
          "id": {"minLength": 1, "type": "string"},
          "material": {"default": true, "type": "boolean"},
          "required": {"default": true, "type": "boolean"},
          "statement": {"minLength": 1, "type": "string"},
          "target": {"minLength": 1, "type": "string"},
          "version": {"minLength": 1, "type": "string"}
        },
        "required": ["id","statement","target","version","accepted"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cost": {"default": 1, "minimum": 1, "type": "integer"},
          "digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": ["string","null"]},
          "eclass": {"enum": ["E0","E1","E2","E3","E4","E5","E6","E7"]},
          "id": {"minLength": 1, "type": "string"},
          "observed_at": {"format": "date-time", "type": "string"},
          "rank": {"minimum": 0, "type": "integer"},
          "source": {"minLength": 1, "type": "string"},
          "status": {"enum": ["PASS","FAIL","CONFLICT","NOT_VERIFIED"]},
          "supports": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
          "target": {"minLength": 1, "type": "string"},
          "valid_until": {"format": "date-time", "type": ["string","null"]},
          "version": {"minLength": 1, "type": "string"}
        },
        "required": ["id","source","status","eclass","target","version","supports","rank","observed_at","digest"],
        "type": "object"
      },
      "type": "array"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "disclose_dissent": {"type": "boolean"},
        "max_cost": {"minimum": 1, "type": "integer"},
        "max_items": {"minimum": 1, "type": "integer"},
        "require_digest": {"type": "boolean"},
        "strict_refs": {"type": "boolean"}
      },
      "type": "object"
    }
  },
  "required": ["as_of","claims","evidence"],
  "title": "NEXY Proof Capsule Proposal Input v1",
  "type": "object"
}
